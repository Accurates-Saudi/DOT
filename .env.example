DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dot_cms"
CMS_SESSION_SECRET="replace-with-a-long-random-secret"
CMS_MEDIA_STORAGE_PATH="./storage/cms-media"

# AWS configuration
# Required for SES email delivery; S3 bucket is required only for S3 media storage.
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION=""
# AWS_S3_BUCKET_NAME=""

# Contact form email delivery via Amazon SES
# Optional: use when SES is configured in a different region than S3/AWS_REGION.
# AWS_SES_REGION=""
# MAIL_FROM=""
# MAIL_TO="info@dynamicoiltools.com"

# Obsolete after SES migration; kept here only as a reminder not to use SMTP for active delivery.
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USERNAME=""
# SMTP_PASSWORD=""
# SMTP_ENCRYPTION=""
# SMTP_FROM=""

# Optional - cap pg pool size per Node process (Render shared Postgres)
# DATABASE_POOL_MAX="5"
# CMS_INITIAL_ADMIN_EMAIL="cms-admin@dynamicoiltools.com"
# CMS_INITIAL_ADMIN_NAME="DOT CMS Administrator"
