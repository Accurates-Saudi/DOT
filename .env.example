DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dot_cms"
CMS_SESSION_SECRET="replace-with-a-long-random-secret"
CMS_MEDIA_STORAGE_PATH="./storage/cms-media"

# Contact form SMTP (required for inquiry email delivery)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="smtp-user@example.com"
# SMTP_PASS="replace-with-smtp-password"
# SMTP_FROM="Dynamic Oil Tools <no-reply@dynamicoiltools.com>"
# CONTACT_INQUIRY_TO="info@dynamicoiltools.com"
# CONTACT_FEEDBACK_TO="feedback@dynamicoiltools.com"

# Optional — cap pg pool size per Node process (Render shared Postgres)
# DATABASE_POOL_MAX="5"
# CMS_INITIAL_ADMIN_EMAIL="cms-admin@dynamicoiltools.com"
# CMS_INITIAL_ADMIN_NAME="DOT CMS Administrator"
